# RUN: rm -rf %t.dir && mkdir -p %t.dir/input %t.dir/output

## Create an object file in the "input" subdirectory.
# RUN: yaml2obj %p/Inputs/ret42.yaml -o %t.dir/input/main.obj

#-----------------------------------------------------------------------------
# Test 1: Basic link with -working-directory resolves input and output files.
#-----------------------------------------------------------------------------
# RUN: lld-link -working-directory:%t.dir/input /entry:main /out:../output/out1.exe main.obj
# RUN: llvm-readobj %t.dir/output/out1.exe | FileCheck -check-prefix=BASIC %s
# BASIC: File:

#-----------------------------------------------------------------------------
# Test 2: The /working-directory: prefix (with /) also works.
#-----------------------------------------------------------------------------
# RUN: lld-link /working-directory:%t.dir/input /entry:main /out:../output/out2.exe main.obj
# RUN: llvm-readobj %t.dir/output/out2.exe | FileCheck -check-prefix=SLASH %s
# SLASH: File:

#-----------------------------------------------------------------------------
# Test 3: /out with a relative path is resolved against working directory.
#-----------------------------------------------------------------------------
# RUN: lld-link -working-directory:%t.dir/output /entry:main /out:out3.exe ../input/main.obj
# RUN: llvm-readobj %t.dir/output/out3.exe | FileCheck -check-prefix=RELOUT %s
# RELOUT: File:

